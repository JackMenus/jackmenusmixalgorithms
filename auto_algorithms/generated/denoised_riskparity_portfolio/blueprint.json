{
  "algo_id": "denoised_riskparity_portfolio",
  "name_zh": "随机矩阵去噪协方差的多空组合（均值-方差 / 层次风险平价）",
  "protocol": "PortfolioConstructor",
  "family": "portfolio.denoised_riskparity",
  "params": {
    "top_k": 15,
