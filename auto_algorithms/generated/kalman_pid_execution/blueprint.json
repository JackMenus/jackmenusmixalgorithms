    "ctrl_out_max": "控制量上限（占母单比例）",
    "kf_obs_mult": "观测噪声倍数（越大公允价越平滑）",
    "fair_horizon_s": "momentum 外推时长（秒）",
    "drift_threshold_bps": "信号生效阈值（bps）",
    "drift_gain": "每倍阈值提前/推后的切片数（0 = 关闭节奏调节）",
    "improve_threshold_bps": "改善/后撤一跳的阈值（bps）",
    "backoff": "信号有利时是否后撤一跳"
  },
